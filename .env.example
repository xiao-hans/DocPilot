# ===== DocPilot 配置示例：复制为 .env 后修改 =====

# ===== 运行环境与数据库 =====
# development 下首次启动自动创建本地开发 schema；生产需先运行 alembic upgrade head
APP_ENV=development
# 默认 SQLite 本地库；部署时设置为 PostgreSQL SQLAlchemy URL
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/docpilot

# ---- 本地依赖栈（docker compose up -d 使用；见 docs/17 §3）----
# 仅面向本机 127.0.0.1，不要把这里的值用于任何联网环境
POSTGRES_USER=docpilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=docpilot
TEST_DATABASE=docpilot_test
# 集成测试指向 PostgreSQL 时设置；不设置则测试继续走一次性 SQLite
# TEST_DATABASE_URL=postgresql+psycopg://docpilot:change-me-local-only@127.0.0.1:5432/docpilot_test

# ---- 任务队列（阶段 G2；docker compose 内的 RabbitMQ）----
RABBITMQ_USER=docpilot
RABBITMQ_PASSWORD=change-me-local-only
# 留空 = 不启用队列，任务仍由 API 进程内执行（现有开发与用例基线）。
# 设置后由派发器投递队列、独立 Worker 消费：python -m app.worker
# BROKER_URL=amqp://docpilot:change-me-local-only@127.0.0.1:5672/
# QUEUE_NAME=docpilot.processing
# WORKER_PREFETCH=4
# JOB_LEASE_SECONDS=120
# 初始化首个管理员/租户的一次性强随机密钥；完成初始化后立即移除/轮换
BOOTSTRAP_TOKEN=
# 生产环境必须启用 Secure Cookie（APP_ENV=production 时默认启用）
# AUTH_COOKIE_SECURE=true
# AUTH_SESSION_DAYS=7

# 提取器模式：mock（默认，不调 LLM，返回真实业务格式示例数据）| llm（调用真实模型）
EXTRACTOR_MODE=mock

# ---- LLM（EXTRACTOR_MODE=llm 时生效；OpenAI 兼容接口）----
# DeepSeek:  https://api.deepseek.com/v1
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:    https://api.openai.com/v1
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT=90
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.1

# ---- 限额（可选，默认值见 app/config.py）----
# MAX_UPLOAD_MB=20
# MAX_FILES_PER_JOB=10
# MAX_PDF_PAGES=20
